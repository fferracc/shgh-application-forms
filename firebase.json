{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.locked.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "refugees-appform",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
